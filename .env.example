# extractive：只摘录检索片段，不调用大模型（演示默认，断网可用）
# llm：调用 OpenAI 兼容接口。未配置 LLM_API_KEY 时仍自动走摘录。
LLM_MODE=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 相关度 = 问题关键词被片段覆盖的比例，范围 0 到 1
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5
DEPLOY_PATH=xxxxxx
# 服务端口
PORT=4004

# 为 1 时，启动从 GitHub 拉取《神农本草经》《黄帝内经素问》《本草纲目》写入本地索引。
# 生产 compose 已设为 1。提问时不访问网络。已导入的书重启后不再下载。
# TCMOC_REFRESH=1 会重新下载。
TCMOC_IMPORT=0